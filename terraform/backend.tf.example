# Copy this file to backend.tf and replace placeholders.
#
# S3-native locking:
#
# terraform {
#   backend "s3" {
#     bucket       = "YOUR-TERRAFORM-STATE-BUCKET"
#     key          = "route53-failover/terraform.tfstate"
#     region       = "ap-south-1"
#     encrypt      = true
#     use_lockfile = true
#   }
# }
#
# Legacy/compatibility DynamoDB locking:
#
# terraform {
#   backend "s3" {
#     bucket         = "YOUR-TERRAFORM-STATE-BUCKET"
#     key            = "route53-failover/terraform.tfstate"
#     region         = "ap-south-1"
#     encrypt        = true
#     dynamodb_table = "YOUR-TERRAFORM-LOCK-TABLE"
#   }
# }
#
# Do not configure both locking methods unless you have deliberately tested
# your Terraform version and organization standards.
